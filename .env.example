# Domain Configuration
DOMAIN=example.com
EMAIL=admin@example.com

# Traefik Dashboard
TRAEFIK_DASHBOARD_SUBDOMAIN=traefik
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD_HASH=$2y$05$iBPMn7PdP7YghIn2DMIrpeQw8aL5VY8KNPsWEsP/DBc0h/cMXuIL.

# OAuth2 Configuration
OAUTH2_SUBDOMAIN=auth
OAUTH2_PROVIDER=github
OAUTH2_CLIENT_ID=your_github_client_id
OAUTH2_CLIENT_SECRET=your_github_client_secret
OAUTH2_COOKIE_SECRET=random_32_char_string_change_me_12345

# API Configuration
API_SUBDOMAIN=api
API_TOKEN=your_api_token_change_me_12345678901234567890
JWT_SECRET=your_jwt_secret_change_me_12345678901234567890

# Service Subdomains
PROTECTED_APP_SUBDOMAIN=protected
PUBLIC_APP_SUBDOMAIN=public
ADMIN_SUBDOMAIN=admin

# Database Configuration
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=strong_db_password_change_me

# Redis Configuration
REDIS_PASSWORD=strong_redis_password_change_me

# Network Configuration
TRAEFIK_NETWORK=traefik
INTERNAL_NETWORK=internal

# SSL Configuration
ACME_STORAGE=/certificates/acme.json
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Security
ALLOWED_IPS=127.0.0.1/32,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12

# Monitoring (Optional)
ENABLE_MONITORING=false
GRAFANA_ADMIN_PASSWORD=strong_grafana_password_change_me
