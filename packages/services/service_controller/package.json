{
  "name": "@jk/service_controller",
  "version": "1.0.0",
  "description": "TypeScript implementation of Nginx template processor for JK project",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "dockerode": "^4.0.0",
    "fs-extra": "^11.2.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.0.4"
  }
}