{
  "services": [
    {
      "host": "auth.marlene.cloud",
      "cert": {
        "file": "/etc/letsencrypt/live/auth.marlene.cloud/fullchain.pem",
        "key_file": "/etc/letsencrypt/live/auth.marlene.cloud/privkey.pem"
      },
      "service": "oauth2-proxy",
      "port": "4180"
    },
    {
      "host": "whoami.marlene.cloud",
      "cert": {
        "file": "/etc/letsencrypt/live/whoami.marlene.cloud/fullchain.pem",
        "key_file": "/etc/letsencrypt/live/whoami.marlene.cloud/privkey.pem"
      },
      "auth": {
        "name": "oauth2-proxy",
        "port": "4180",
        "auth_headers": true
      },
      "service": "whoami",
      "port": "80"
    }
  ]
}
